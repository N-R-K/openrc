#!/sbin/openrc-run

command="/usr/bin/clipmenud"
# gets ignored if user has cm_dir set in
# ~/.config/clipmenu/clipmenu.conf
# export XDG_RUNTIME_DIR="/run/user-${USER}"

supervisor=supervise-daemon
respawn_delay=256ms
respawn_max=8
respawn_period=16

start_pre() {
	x_env="/run/user-$(whoami)/X.env"
	[ -z "${DISPLAY}" ] && [ -f "$x_env" ] && . "$x_env"
	export DISPLAY
}

depend() { need X; }
