#!/sbin/openrc-run

command="/usr/bin/clipmenud"
# gets ignored if user has cm_dir set in
# ~/.config/clipmenu/clipmenu.conf
# export XDG_RUNTIME_DIR="/run/user-${USER}"

supervisor=supervise-daemon
respawn_delay=256ms
respawn_max=8
respawn_period=16

start_pre() {
	if [ -z "${DISPLAY}" ]; then
		eerror "DISPLAY not set, make sure it's allowed through rc_env_allow"
		return 1
	fi
}

