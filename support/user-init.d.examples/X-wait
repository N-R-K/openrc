#!/sbin/openrc-run

command="/usr/libexec/rc/bin/X-wait"

supervisor=supervise-daemon
respawn_delay=200ms
respawn_max=5
respawn_period=16
notify="fd:3"
output_log="/run/user-$(whoami)/X.env"

start_pre() {
	if [ -z "${DISPLAY}" ]; then
		eerror "DISPLAY not set, make sure it's allowed through rc_env_allow"
		return 1
	fi
}

depend() {
	provide X
}
